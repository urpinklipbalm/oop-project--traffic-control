@startuml SmartCityTrafficControl

' same diagram as class-diagram.md, in PlantUML syntax for anyone who
' prefers that toolchain (e.g. the PlantUML VS Code extension, or
' plantuml.com's online renderer) to export a PNG/PDF for submission.

abstract class Vehicle {
  -id: String
  -customLabel: String
  -route: List<Intersection>
  -routeIndex: int
  -travelState: TravelState
  -placement: RoadPlacement
  -cumulativeWaitMillis: long
  +getPriority(): int
  +getSpeedMetersPerSecond(): double
  +getColor(): Color
  +getTypeName(): String
  +getCustomLabel(): String
  +advanceToNextIntersection()
  +isAtDestination(): boolean
  +enterRoad(Road, long)
  +hasFinishedCurrentRoad(long, double): boolean
  +getProgressAlongRoad(long, double): double
  +startWaiting(long)
  +addWaitTime(long)
}
class Car
class Bus
class Motorcycle
class EmergencyVehicle {
  +{static} PRIORITY: int
}
Vehicle <|-- Car
Vehicle <|-- Bus
Vehicle <|-- Motorcycle
Vehicle <|-- EmergencyVehicle

enum Direction {
  NORTH
  SOUTH
  EAST
  WEST
  +isNorthSouthAxis(): boolean
  +opposite(): Direction
}

enum LightPhase {
  NS_GREEN
  NS_YELLOW
  EW_GREEN
  EW_YELLOW
  ALL_RED
  +isGreenFor(Direction): boolean
  +isYellowFor(Direction): boolean
}

class Position {
  -x: double
  -y: double
}

class Road {
  -id: String
  -from: Intersection
  -to: Intersection
  -lengthMeters: double
  -lanes: int
  -approachDirection: Direction
  -vehiclesOnRoad: List<Vehicle>
  +getTravelTimeMillis(double): long
  +getCongestionRatio(): double
  +addVehicle(Vehicle)
  +removeVehicle(Vehicle)
}

class TrafficLight implements Runnable {
  -intersectionId: String
  -phase: LightPhase
  -preemptRequested: boolean
  -nsGreenMillis: long
  -ewGreenMillis: long
  +run()
  +preempt(Direction)
  +isGreenFor(Direction): boolean
  +setNsGreenDurationMillis(long)
  +setEwGreenDurationMillis(long)
  +prepareForStart()
  +stop()
}

class Intersection {
  -id: String
  -position: Position
  -trafficLight: TrafficLight
  -queues: Map<Direction, Deque<Vehicle>>
  -queueLock: ReentrantLock
  +enqueue(Direction, Vehicle)
  +tryDequeue(Direction, long): Vehicle
  +getQueueLength(Direction): int
  +getQueuedVehicles(Direction): List<Vehicle>
  +getTotalQueueLength(): int
}

class CityMap {
  -intersections: Map<String, Intersection>
  -adjacency: Map<String, Map<String, Road>>
  -roads: List<Road>
  +addIntersection(Intersection)
  +addRoad(Road)
  +getRoute(String, String): List<Intersection>
  +getRoad(String, String): Road
}

Intersection *-- "1" TrafficLight
CityMap *-- "many" Intersection
CityMap *-- "many" Road
Road --> "2" Intersection
Vehicle --> "many" Intersection : route
Vehicle --> "0..1" Road : currentRoad

interface TrafficEventPublisher {
  +publishVehicleSpawned(Vehicle)
  +publishVehicleRestored(Vehicle)
  +publishVehicleArrived(Vehicle, long, long)
  +publishLightPhaseChanged(String, LightPhase)
  +publishPreemption(String, Direction)
  +publishMessage(String)
}

interface TrafficObserver {
  +onVehicleSpawned(Vehicle)
  +onVehicleRestored(Vehicle)
  +onVehicleArrived(Vehicle, long, long)
  +onLightPhaseChanged(String, LightPhase)
  +onPreemption(String, Direction)
  +onSimulationMessage(String)
}

class SimulationClock {
  -speedFactor: double
  +getSpeedFactor(): double
  +setSpeedFactor(double)
}

enum TrafficVolume {
  LIGHT
  NORMAL
  BUSY
  RUSH_HOUR
  +getIntervalMultiplier(): double
}

class SimulationEngine implements TrafficEventPublisher {
  -cityMap: CityMap
  -statistics: SimulationStatistics
  -clock: SimulationClock
  -observers: List<TrafficObserver>
  -executor: ExecutorService
  -running: AtomicBoolean
  -trafficVolume: TrafficVolume
  +start()
  +stop()
  +addObserver(TrafficObserver)
  +removeObserver(TrafficObserver)
  +setTrafficVolume(TrafficVolume)
  +spawnCar(): Vehicle
  +spawnCar(String, String, String): Vehicle
  +restoreVehicles(List<SavedVehicle>)
}
SimulationEngine o-- "many" TrafficObserver : notifies
SimulationEngine *-- CityMap
SimulationEngine *-- SimulationStatistics
SimulationEngine *-- SimulationClock
SimulationEngine +-- TrafficVolume : nested enum

class VehicleSpawner implements Runnable {
  -spawnIntervalMultiplier: double
  +run()
  +spawnCarNow(): Vehicle
  +spawnCarNow(String, String, String): Vehicle
  +restoreVehicle(SavedVehicle): Vehicle
  +setSpawnIntervalMultiplier(double)
  +stop()
}
class VehicleMover implements Runnable {
  +run()
  +stop()
}
class AdaptiveSignalController implements Runnable {
  +run()
  +stop()
}
SimulationEngine *-- VehicleSpawner
SimulationEngine *-- VehicleMover
SimulationEngine *-- AdaptiveSignalController

class SimulationStatistics {
  -vehiclesSpawned: AtomicLong
  -vehiclesArrived: AtomicLong
  -totalWaitTimeMillis: AtomicLong
  -totalTravelTimeMillis: AtomicLong
  +recordSpawn()
  +recordArrival(long, long)
  +restore(long, long, double, double)
  +getAverageWaitTimeMillis(): double
  +getAverageTravelTimeMillis(): double
}

interface PersistenceService {
  +loadCityMap(String): CityMap
  +saveCityMap(CityMap, String)
  +exportStatistics(SimulationStatistics, String)
}

class CsvCityMapLoader implements PersistenceService {
  +loadCityMap(String): CityMap
  +saveCityMap(CityMap, String)
  +exportStatistics(SimulationStatistics, String)
  +loadSnapshot(String): SimulationSnapshot
  +saveSnapshot(CityMap, SimulationStatistics, String)
}
CsvCityMapLoader ..> CityMap : creates
CsvCityMapLoader ..> SimulationSnapshot : creates

class SimulationSnapshot {
  -cityMap: CityMap
  -vehiclesSpawned: long
  -vehiclesArrived: long
  -averageWaitTimeMillis: double
  -averageTravelTimeMillis: double
  -unfinishedVehicles: List<SavedVehicle>
  +getCityMap(): CityMap
  +getUnfinishedVehicles(): List<SavedVehicle>
}
class SavedVehicle << record >> {
  +type: String
  +originId: String
  +destinationId: String
  +customLabel: String
}
SimulationSnapshot +-- SavedVehicle : nested record
SimulationSnapshot *-- CityMap

class EventLogger implements TrafficObserver {
  -writer: BufferedWriter
  +close()
}

class DefaultCityMapFactory <<utility, legacy>> {
  +{static} createDefaultGrid(): CityMap
}
note right of DefaultCityMapFactory : superseded by CsvCityMapLoader;\nkept for reference/tests only
DefaultCityMapFactory ..> CityMap : builds

class MainFrame implements TrafficObserver {
  -engine: SimulationEngine
  -cityPanel: CityPanel
  -persistence: CsvCityMapLoader
  -eventLog: JTextArea
  +startSimulation()
  +stopSimulation()
  +spawnCar()
  +loadCityMap(Path)
  +saveSnapshot()
  +loadSnapshot()
  +exportStatistics()
}
MainFrame --> SimulationEngine : controls
MainFrame ..> CsvCityMapLoader : uses

class CityPanel implements TrafficObserver {
  -engine: SimulationEngine
  -incomingRoads: Map<Intersection, Map<Direction, Road>>
  -lastPreemption: Map<String, Long>
  -labeledVehicles: Map<String, Vehicle>
  +paintComponent(Graphics)
  +disposePanel()
}
note right of CityPanel : the animated map - repaints on a\nswing Timer, reads simulation state\nonly, never writes back
MainFrame *-- CityPanel

class InvalidRouteException <<checked>>
class CityMapLoadException <<checked>>
class SimulationStateException <<unchecked>>

@enduml
